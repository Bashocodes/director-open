{
  "name": "director-mcp",
  "version": "0.1.0-alpha.0",
  "description": "A local, file-based MCP server for Director Open projects.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "director-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "^5.5.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.10"
  }
}
