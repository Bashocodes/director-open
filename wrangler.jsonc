{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "director-open",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-20",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
